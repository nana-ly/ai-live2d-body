# --- Body (peripheral) ---
# Default: body-only mode — no LLM in the pet process.
# Set PET_BODY_ONLY=0 to enable embedded AI chat (legacy).
PET_BODY_ONLY=1
PET_CONTROL_PORT=39271
# Optional override for the local structured memory index.
# PET_MEMORY_PATH=D:\path\to\memory-index.json

# Claude Code session jsonl directory (run hooks/setup-claude.ps1 to auto-fill)
# CLAUDE_TRANSCRIPT_DIR=C:\Users\YOU\.claude\projects\D--QQdown-ai-live2d-body
# CLAUDE_TRANSCRIPT_PATH=
# TRANSCRIPT_POLL_MS=800
# BUBBLE_FADE_MS=30000

# Touch / pulse injection via WSL tmux (Windows)
PET_TMUX_VIA_WSL=1
WSL_DISTRO=Ubuntu
TMUX_SESSION=claude
TMUX_TARGET=0
# --- Pulse wake (Leo proactively speaks after idle) ---
PET_PULSE=1
PULSE_IDLE_MS=300000
PULSE_CHECK_MS=5000
PULSE_COOLDOWN_MS=300000
# MurMur uses the pulse idle/cooldown settings and can override its cooldown.
# MURMUR_COOLDOWN_MS=900000

# --- Legacy embedded brain (PET_BODY_ONLY=0) ---
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
AI_ENABLE_TOOLS=1
AI_RESPONSE_FORMAT=json_object
RIPPLE_MEMORY_DIR=D:\Ripple\vault\memories
